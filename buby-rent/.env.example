POSTGRES_USER=buby
POSTGRES_PASSWORD=cambia_questa_password
POSTGRES_DB=buby_rent

# development | production (in production le chiavi di sviluppo bloccano l'avvio)
ENVIRONMENT=development
# Origini browser autorizzate, separate da virgola (aggiungi l'URL esatto del preview Lovable)
CORS_ORIGINS=http://localhost:3000
# URL API incorporato nel bundle React durante la build Docker
VITE_API_URL=http://localhost:8000

# Chiave per firmare i token JWT. Generala con:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambia_con_una_stringa_lunga_e_casuale
ACCESS_TOKEN_MINUTES=60

# Cifratura dei dati personali (Fernet). Una o piu chiavi separate da virgola:
# la prima cifra, tutte decifrano (serve per ruotare le chiavi). Generala con:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ATTENZIONE: se perdi la chiave i dati cifrati non sono recuperabili. Fanne un backup separato.
ENCRYPTION_KEYS=
# Chiave per cercare l'email senza salvarla in chiaro. Generala come SECRET_KEY, diversa dalle altre.
BLIND_INDEX_KEY=

# Supabase Auth: abilita la verifica JWT Supabase nell'API.
# La chiave publishable e pubblica ma viene usata dall'API solo per verificare
# l'identita via Auth quando si collega/provisiona un account.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Utenti di prova creati al primo avvio (cambiali)
ADMIN_EMAIL=admin@buby.it
ADMIN_PASSWORD=admin12345
OPERATORE_PASSWORD=operatore12345
